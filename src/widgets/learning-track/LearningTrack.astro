---
import { useTranslations } from '@shared/i18n/translator';
import type { Locale } from '@shared/i18n/locales';
import { ANCHORS } from '@shared/config/site';
import { STAGES, modulesInStage } from '@entities/learning-module/model/curriculum';
import BrandTrack from './BrandTrack.astro';
import MetricsBand from './MetricsBand.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t, plural } = useTranslations(locale);
const stageLabels = STAGES.map((stage) => t(stage.labelKey));
---

<section class="track pl-field--deep" id={ANCHORS.track}>
  <div class="pl-container">
    <p class="pl-overline pl-overline--field">{t('home.track.overline')}</p>
    <div class="track__header">
      <h2 class="pl-section-title track__title">{t('home.track.title')}</h2>
      <p class="pl-lede pl-lede--field track__lead">{t('home.track.lead')}</p>
    </div>

    <BrandTrack label={t('home.track.diagramLabel')} stageLabels={stageLabels} />

    <div class="track__stages">
      {STAGES.map((stage) => (
        <article class="pl-card--on-field track__card">
          <h3 class="track__card-title">
            <span class="pl-only-narrow">{stage.id} · </span>
            {t(stage.titleKey)}
            <span class="track__modules pl-mono">
              {plural('home.track.moduleCount', modulesInStage(stage.id).length)}
            </span>
          </h3>
          <p class="track__summary">{t(stage.summaryKey)}</p>
          <ul class="track__topics pl-only-wide">
            {modulesInStage(stage.id).map((module) => (
              <li class="track__topic pl-mono">{t(`topic.${module.id}`)}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <MetricsBand locale={locale} />
    <p class="track__footer">{t('home.track.footer')}</p>
  </div>
</section>

<style>
  .track {
    margin-top: 64px;
    padding-top: 56px;
    padding-bottom: 56px;
  }

  .track__title {
    margin-top: 14px;
    color: var(--pl-on-field);
  }

  .track__lead {
    margin-top: var(--pl-space-md);
  }

  .track__footer {
    margin-top: var(--pl-space-lg);
    max-width: 820px;
    font-size: 14px;
    line-height: 1.65;
    color: var(--pl-on-field-2);
  }

  .track__stages {
    display: flex;
    flex-direction: column;
    gap: 14px;
    margin-top: var(--pl-space-xs);
  }

  .track__card {
    padding: 20px 18px;
  }

  .track__card-title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 10px;
    margin: 0 0 var(--pl-space-xs);
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--pl-on-field);
  }

  .track__modules {
    font-size: 12px;
    font-weight: 400;
    color: var(--pl-on-field-3);
  }

  .track__summary {
    font-size: 14px;
    line-height: 1.6;
    color: var(--pl-on-field-2);
  }

  .track__topics {
    display: flex;
    flex-wrap: wrap;
    gap: var(--pl-space-xs);
    margin-top: 20px;
  }

  .track__topic {
    padding: 6px 10px;
    border: 1px solid var(--pl-on-field-line-soft);
    border-radius: var(--pl-radius-sm);
    font-size: 11px;
    color: var(--pl-on-field-2);
  }

  @media (min-width: 900px) {
    .track {
      margin-top: 112px;
      padding-top: 96px;
      padding-bottom: 96px;
    }

    .track__header {
      display: flex;
      align-items: flex-end;
      gap: 64px;
    }

    .track__title {
      flex: 1;
      max-width: 700px;
      margin-top: 0;
    }

    .track__lead {
      width: 440px;
      flex: none;
      margin-top: 0;
      font-size: 16px;
    }

    .track__footer {
      margin-top: 28px;
      font-size: 15px;
    }

    .track__stages {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--pl-space-lg);
    }

    .track__card {
      padding: 26px var(--pl-space-lg);
    }

    .track__card-title {
      font-size: 19px;
    }
  }
</style>
