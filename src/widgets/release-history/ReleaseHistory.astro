---
import { useTranslations } from '@shared/i18n/translator';
import type { Locale } from '@shared/i18n/locales';
import { ANCHORS } from '@shared/config/site';
import { RELEASES, oldestRelease } from '@entities/release/model/release-catalog';
import ReleaseEntry from './ReleaseEntry.astro';

export interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useTranslations(locale);
const first = oldestRelease();
---

<section class="release-history" id={ANCHORS.releaseHistory}>
  <div class="pl-container">
    <p class="pl-overline pl-overline--brand">{t('versions.history.overline')}</p>
    <h2 class="pl-section-title pl-section-title--sub release-history__title">
      {t('versions.history.title')}
    </h2>
    <p class="pl-lede release-history__lead">{t('versions.history.lead')}</p>

    <ol class="release-history__list">
      {RELEASES.map((release) => (
        <ReleaseEntry locale={locale} release={release} />
      ))}
    </ol>

    <p class="pl-card--dashed release-history__floor">
      <span class="pl-overline">{t('versions.history.floorLabel')}</span>
      <span>{t('versions.history.floorText', { version: first.version })}</span>
    </p>
  </div>
</section>

<style>
  .release-history {
    padding-top: var(--pl-space-3xl);
  }

  .release-history__title {
    margin-top: 14px;
    max-width: 820px;
  }

  .release-history__lead {
    margin-top: var(--pl-space-md);
    max-width: 720px;
  }

  .release-history__list {
    display: flex;
    flex-direction: column;
    gap: var(--pl-space-md);
    margin-top: 28px;
  }

  .release-history__floor {
    display: flex;
    flex-direction: column;
    gap: var(--pl-space-xs);
    margin-top: var(--pl-space-md);
    padding: var(--pl-space-md) 18px;
    border-radius: var(--pl-radius-card);
    font-size: 14px;
    line-height: 20px;
    color: var(--pl-ink-2);
  }

  @media (min-width: 900px) {
    .release-history {
      padding-top: var(--pl-space-4xl);
    }

    .release-history__title {
      margin-top: 20px;
    }

    .release-history__lead {
      margin-top: 18px;
    }

    .release-history__list {
      gap: 20px;
      margin-top: 40px;
    }

    .release-history__floor {
      margin-top: 20px;
      padding: 18px 22px;
    }
  }
</style>
