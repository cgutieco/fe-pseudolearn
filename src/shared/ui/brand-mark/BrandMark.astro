---
import { BRAND_SYMBOL_PATH, BRAND_SYMBOL_VIEW_BOX } from './symbol-path.generated';

export interface Props {
  size?: number;
  class?: string;
}

const { size = 26, class: className } = Astro.props;
---

<svg
  viewBox={BRAND_SYMBOL_VIEW_BOX}
  width={size}
  height={size}
  class={className}
  role="img"
  aria-hidden="true"
  focusable="false"
>
  <path fill="currentColor" d={BRAND_SYMBOL_PATH}></path>
</svg>
